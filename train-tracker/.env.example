# Copy to .env and fill in. Never commit .env.
# Zero spend: nothing here may need a card on file.

# --- Ingest worker only. Never expose these to the browser. ---

# RailRadar API key. Get one at https://railradar.in/developers
RAILRADAR_API_KEY=
# Monthly free quota, and the part of it only --demo may spend.
RAILRADAR_MONTHLY_BUDGET=100
RAILRADAR_DEMO_RESERVE=55

# RapidAPI key, subscribed to the IRCTC1 free plan. Skip if it asks for a card.
RAPIDAPI_KEY=
RAPIDAPI_IRCTC1_HOST=irctc1.p.rapidapi.com
RAPIDAPI_MONTHLY_BUDGET=20
RAPIDAPI_DEMO_RESERVE=10

# Scrape second opinion. Set to false to disable it entirely.
SCRAPE_ENABLED=true
SCRAPE_MIN_INTERVAL_SEC=60
SCRAPE_USER_AGENT="train-tracker portfolio project (contact: you@example.com)"

# Supabase service role key. Full write access. Worker only.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Window checks
WINDOW_CHECK_INTERVAL_MIN=5
# Intervals while a train is late, in order. The last one repeats.
LATE_CHECK_INTERVALS_MIN=5,5,10,10,15

# Hours after a journey ends before its data is deleted. Scores and caps are kept.
RETENTION_HOURS=24

# --- Web app. VITE_ variables are shipped to the browser. Public values only. ---

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# OpenFreeMap style. Free, no key. Check https://openfreemap.org/quick_start/ for the current URL.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
